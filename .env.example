# === 数据库（Neon） =========================================================
# 池化连接，运行时使用
DATABASE_URL=
# 直连连接，仅 prisma migrate 使用
DATABASE_URL_UNPOOLED=

# === 会话 ===================================================================
# 32 字节以上随机串，每个环境独立
AUTH_SECRET=

# === 登录开关 ===============================================================
# 生产必须为 false
ALLOW_DEMO_LOGIN=false
ALLOW_OPEN_SIGNUP=false

# === GitHub OAuth App（登录） ===============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 必须与 GitHub OAuth App 中配置的回调地址一致
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# === GitHub App（Issue / 评论 / 术语库 PR / Webhook） =======================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# 内容仓库：owner/repo，例如 your-org/translation-terms
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main
# 可选：用个人 token 代替 App（仅本地调试）
GITHUB_TOKEN=

# === 限流 / 缓存（Upstash Redis） ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === 文件（Vercel Blob） ====================================================
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# === 运维入口 ===============================================================
# 手动触发 /api/v1/sync 的共享密钥（可选）
SYNC_TOKEN=
# Vercel Cron 请求鉴权（可选；生产建议设置）
CRON_SECRET=
